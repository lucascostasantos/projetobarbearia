<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Login/Cadastrar</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    
    <style>
        .container {
            display: grid;
            place-items: center;
            width: 35%;
            height: 420px;
            background-color: black;
            border-radius: 37px;
            margin-top: 10%;
            padding-bottom: 20px;
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.5);
        }

        body{
            background-color: rgba(37, 36, 36, 1);
        }

        h1{
            font-size: 20px;
            color: white;
            font-weight: bold;
            margin-top: 7px;
        }

        .form-control{
            border-radius: 80px;
            height: 45px;
            background-color: rgb(199, 194, 194);
        }

        p{
            display: inline;
            color: white;
            font-weight: bold;
            font-size: 12px;
        }

        form {
            display: none;
        }
        form.active {
            display: block;
        }

        .toggle-link {
            color: #007bff;
            cursor: pointer;
            text-decoration: none;
        }
        .toggle-link:hover {
            color: #0056b3;
        }

        .toggle-link {
            cursor: pointer;
            font-weight: bold;
            padding: 10px;
            color: white; 
            background-color: transparent;
        }

        .toggle-link.active {
            color: orange;
        }

        .container.small {
            height: 400px;
        }

        .container.large {
            margin-top: 6%;
            height: 500px;
        }

        #erro-message {
            height: 20px; /* Altura fixa */
            color: rgb(194, 176, 176);
            font-size: 14px;
            width: 60%;
            text-align: center;
            margin: 0 auto; /* Centraliza horizontalmente */
            visibility: hidden; /* Mantém o espaço reservado sem exibir o texto */
            opacity: 0; /* Torna invisível */
            transition: opacity 0.3s ease-in-out; /* Animação suave */
            margin-top: 5px;
        }

    </style>


</head>
<body>
    <div class="container" id="formContainer">
        <div style="margin-top: 20px; margin-bottom:20px">
            <img style="width: 50px;" src="/images/logobarbearia.png">
            <h1 style="display: inline;">LMBARBEARIA</h1>
        </div>
        <form style="width: 70%; text-align:center" id="formulariologin" class="active" action="/login" method="post">
            <input style="margin-bottom: 25px;" type="email" name="email" class="form-control" placeholder="EMAIL">
            <input style="margin-bottom: 30px;" type="password" name="senha" class="form-control"  placeholder="SENHA">
            <button type="submit" id="btn-login" class="btn btn" style="width: 320px; background-color: rgb(255, 94, 0); color: white; border-radius: 80px; height: 45px; font-weight: bold; margin-bottom:15px">LOGIN</button>
            <a style="cursor: pointer; text-decoration: none;" href="#"><p class="senha" style="color:gray;">Esqueceu a senha?</p></a>
            <div style="margin-top:10px; color:white">
                <h7>Não tem conta?<p id="aba-cadastrar" onclick="showRegister()" class="toggle-link">CADASTRAR-SE</p></h7>
            </div>
            <div id="erro-message" role="alert" >
                Email e/ou Senha Incorretos
            </div>
        </form>
        <form style="width: 70%;text-align:center" id="formulariocadastro" method="post">
            <input style="margin-bottom: 25px;" type="text" class="form-control" id="nome"  name="nome" placeholder="NOME">
            <input style="margin-bottom: 30px;" type="email" class="form-control" id="email" name="email" placeholder="EMAIL">
            <input style="margin-bottom: 30px;" type="tel" class="form-control" id="telefone" name="telefone" placeholder="TELEFONE">
            <input style="margin-bottom: 30px;" type="password" class="form-control" id="senha"  name="senha" placeholder="SENHA">
            <button type="submit" id="btn-cadastrar" class="btn btn" style="width: 320px; background-color: rgb(255, 94, 0); color: white; border-radius: 80px; height: 45px; font-weight: bold;">CADASTRAR</button>
            <div style="margin-top:10px; color:white">
                <h7>Já possui uma conta?<p id="aba-login" onclick="showLogin()" class="toggle-link active">LOGIN</p></h7>
            </div>
            <div id="cadastro-erro-message" style="text-align: center;" class="text-danger small mt-1" style="visibility: hidden;"></div>
        </form>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="successToast" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    Cadastro realizado com sucesso!
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    

    <script>

        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('erro')) {
            document.getElementById('erro-message').style.display = 'block';
        }

        function showLogin() {

            document.getElementById('formulariologin').classList.add('active');
            document.getElementById('formulariocadastro').classList.remove('active');

            const formContainer = document.getElementById('formContainer');
            formContainer.classList.add('small');
            formContainer.classList.remove('large');

            document.getElementById('aba-login').classList.add('active');
            document.getElementById('aba-cadastrar').classList.remove('active');
        }

        function showRegister() {

            document.getElementById('formulariocadastro').classList.add('active');
            document.getElementById('formulariologin').classList.remove('active');

            const formContainer = document.getElementById('formContainer');
            formContainer.classList.add('large');
            formContainer.classList.remove('small');

            document.getElementById('aba-cadastrar').classList.add('active');
            document.getElementById('aba-login').classList.remove('active');
        }

        document.addEventListener('DOMContentLoaded', () => {
            const telefoneInput = document.querySelector('#telefone');

            telefoneInput.addEventListener('input', () => {
                let numero = telefoneInput.value.replace(/\D/g, ''); // Remove tudo que não for número
                
                if (numero.length > 11) {
                    numero = numero.slice(0, 11); // Limita o número a 11 dígitos
                }

                // Aplica a máscara com base no tamanho do número
                if (numero.length <= 10) {
                    telefoneInput.value = numero.replace(/(\d{2})(\d{4})(\d{0,4})/, '($1) $2-$3');
                } else {
                    telefoneInput.value = numero.replace(/(\d{2})(\d{5})(\d{0,4})/, '($1) $2-$3');
                }
            });
        });

        
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.querySelector('#formulariocadastro');
            const abaLogin = document.querySelector('#aba-login');
            const successToast = new bootstrap.Toast(document.getElementById('successToast'));

            let cadastroConcluido = false; 

            // Elemento para exibir mensagens de erro
            const erroMessage = document.getElementById('cadastro-erro-message');

            // Função para exibir mensagens de erro
            function exibirErro(mensagem) {
                erroMessage.textContent = mensagem;
                erroMessage.style.visibility = 'visible';
                setTimeout(() => {
                    erroMessage.style.visibility = 'hidden';
                }, 3000);
            }

            // Validações em tempo real
            const emailInput = document.querySelector('#email');
            const telefoneInput = document.querySelector('#telefone');

            emailInput.addEventListener('blur', () => {
                const emailValido = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                if (!emailValido.test(emailInput.value.trim())) {
                    exibirErro('E-mail inválido.');
                }
            });

            telefoneInput.addEventListener('input', () => {
                let telefone = telefoneInput.value.replace(/\D/g, ''); // Remove tudo que não é número
                if (telefone.length >= 11) {
                    telefone = telefone.replace(/^(\d{2})(\d{5})(\d{4})$/, '($1) $2-$3');
                } else if (telefone.length >= 10) {
                    telefone = telefone.replace(/^(\d{2})(\d{4})(\d{4})$/, '($1) $2-$3');
                }
                telefoneInput.value = telefone;
            });

            form.addEventListener('submit', async (e) => {
                e.preventDefault(); // Evita o recarregamento da página

                // Captura os valores do formulário
                const nome = document.querySelector('#nome').value.trim();
                const email = emailInput.value.trim();
                const telefone = telefoneInput.value.trim();
                const senha = document.querySelector('#senha').value.trim();

                // Validações
                if (!nome || !email || !telefone || !senha) {
                    exibirErro('Todos os campos são obrigatórios.');
                    return;
                }

                const emailValido = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                if (!emailValido.test(email)) {
                    exibirErro('E-mail inválido.');
                    return;
                }

                try {
                    // Requisição para o backend
                    const response = await fetch('http://localhost:3000/usuarios', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ nome, email, telefone, senha }),
                    });

                    // Tenta extrair a resposta como JSON
                    let data = {};
                    try {
                        data = await response.json();
                    } catch {
                        throw new Error('Resposta inválida do servidor.');
                    }

                    if (response.ok) {
                        cadastroConcluido = true; // Marca como sucesso
                        abaLogin.click(); // Troca para a aba de login

                        // Limpa os campos do formulário
                        form.reset();
                    } else {
                        // Exibe mensagem de erro retornada pelo servidor
                        exibirErro(data.message || 'Erro ao cadastrar.');
                    }
                } catch (error) {
                    console.error('Erro:', error);
                    exibirErro('Erro no servidor. Tente novamente!');
                }
            });

            // Exibe o toast após cadastro bem-sucedido
            abaLogin.addEventListener('click', () => {
                if (cadastroConcluido) {
                    successToast.show(); // Exibe o toast de sucesso
                    cadastroConcluido = false; // Reseta o estado
                }
            });
        });



        document.querySelector('#formulariologin').addEventListener('submit', async (e) => {
                e.preventDefault(); // Impede o envio tradicional do formulário

                const email = document.querySelector('input[name="email"]').value;
                const senha = document.querySelector('input[name="senha"]').value;
                const erroMessage = document.getElementById('erro-message');

                try {
                    const response = await fetch('/login', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ email, senha }),
                    });

                    const data = await response.json();

                    if (response.ok) {
                        // Redireciona para a tela inicial se o login for bem-sucedido
                        window.location.href = '/telainicial';
                    } else {
                        erroMessage.textContent = 'Email e/ou Senha Incorreto(s)';
                        erroMessage.style.visibility = 'visible';
                        erroMessage.style.opacity = '1';

                        setTimeout(() => {
                            erroMessage.style.opacity = '0';
                            setTimeout(() => {
                                erroMessage.style.visibility = 'hidden';
                            }, 300);
                        }, 3000);
                    }
                } catch (error) {
                    console.error('Erro ao fazer login:', error);
                    erroMessage.textContent = 'Erro ao conectar com o servidor. Tente novamente!';
                    erroMessage.style.display = 'block';
                }
            });

    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>